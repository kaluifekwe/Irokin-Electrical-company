---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Industrial Panel Installation",
    category: "Electrical Engineering",
    description: "Design and assembly of a main distribution board for a commercial complex in Abia State.",
    tag: "Automation"
  },
  {
    title: "Modern Residential Duplex",
    category: "Building Construction",
    description: "Complete structural build and finishing for a premium residential property.",
    tag: "Structural"
  },
  {
    title: "Hybrid Smart Solar System",
    category: "Solar & Smart Systems",
    description: "Installation of a 10kVA hybrid solar system with intelligent load management.",
    tag: "Renewable"
  },
  {
    title: "Commercial Interior Finishing",
    category: "Interior & Finishing",
    description: "Master-level POP installation and spatial finishing for a corporate office.",
    tag: "Finishing"
  },
  {
    title: "Industrial PLC Integration",
    category: "Automation",
    description: "Programming and integration of PLC systems for a local manufacturing plant.",
    tag: "Advanced Tech"
  },
  {
    title: "Low-Voltage Diagnostic Project",
    category: "Electrical Repairs",
    description: "Comprehensive troubleshooting and repair of complex control circuits.",
    tag: "Precision"
  }
];
---

<Layout title="Our Projects">
  <!-- Page Header -->
  <section class="bg-irokin-blue text-white py-20 px-6 border-b-8 border-irokin-gold">
    <div class="container mx-auto">
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-4">Our Projects</h1>
      <p class="text-irokin-metallic text-xl max-w-3xl">A portfolio of engineering excellence, technical precision, and structural integrity.</p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-24 px-6 bg-slate-50">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
        {projects.map((project) => (
          <div class="group bg-white border-2 border-irokin-blue shadow-[12px_12px_0px_0px_rgba(10,25,47,1)] hover:shadow-none transition-all flex flex-col">
            <!-- Project Image Placeholder -->
            <div class="aspect-video bg-slate-200 border-b-2 border-irokin-blue flex items-center justify-center relative overflow-hidden">
               <span class="text-irokin-blue font-black uppercase tracking-widest text-xs opacity-50">{project.category} Placeholder</span>
               <div class="absolute top-4 left-4">
                  <span class="bg-irokin-gold text-irokin-blue text-[10px] font-black uppercase px-2 py-1 tracking-tighter">
                    {project.tag}
                  </span>
               </div>
            </div>
            <!-- Project Content -->
            <div class="p-8 flex-grow">
              <p class="text-irokin-gold text-xs font-black uppercase mb-2 tracking-widest">{project.category}</p>
              <h3 class="text-xl font-black text-irokin-blue uppercase tracking-tighter mb-4 group-hover:text-irokin-metallic transition-colors">
                {project.title}
              </h3>
              <p class="text-gray-600 font-body text-sm leading-relaxed">
                {project.description}
              </p>
            </div>
            <!-- Footer/Link -->
            <div class="px-8 pb-8">
               <a href="/contact" class="inline-block text-irokin-blue font-black uppercase text-xs border-b-2 border-irokin-gold hover:text-irokin-gold transition-colors">
                 Inquire about similar project &rarr;
               </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Authority Section -->
  <section class="py-24 px-6 bg-irokin-blue text-white border-y-8 border-irokin-gold">
    <div class="container mx-auto text-center max-w-4xl">
       <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter mb-8 italic">"Establishing deep technical authority through every brick laid and every wire connected."</h2>
       <p class="text-irokin-metallic font-body text-lg mb-12">
         Our projects are more than just contracts; they are a testament to our commitment to the technical advancement of Abia State. We bring global engineering standards to local needs.
       </p>
       <div class="flex flex-wrap justify-center gap-8">
          <div class="border-2 border-irokin-metallic px-6 py-4">
             <span class="block text-irokin-gold text-2xl font-black">100+</span>
             <span class="text-xs uppercase font-bold tracking-widest">Projects Delivered</span>
          </div>
          <div class="border-2 border-irokin-metallic px-6 py-4">
             <span class="block text-irokin-gold text-2xl font-black">RC: 9500063</span>
             <span class="text-xs uppercase font-bold tracking-widest">Certified Corporate Entity</span>
          </div>
          <div class="border-2 border-irokin-metallic px-6 py-4">
             <span class="block text-irokin-gold text-2xl font-black">24/7</span>
             <span class="text-xs uppercase font-bold tracking-widest">Support & Maintenance</span>
          </div>
       </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 px-6 bg-white text-center">
    <div class="container mx-auto">
      <h2 class="text-3xl font-black text-irokin-blue uppercase tracking-tighter mb-8">Ready to Build Your Vision?</h2>
      <a href="/contact" class="inline-block bg-irokin-gold text-irokin-blue px-12 py-4 font-black uppercase tracking-widest hover:bg-yellow-400 transition-colors shadow-xl">
        Get a Quote for Your Project
      </a>
    </div>
  </section>
</Layout>
