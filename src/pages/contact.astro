---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <!-- Page Header -->
  <section class="bg-irokin-blue text-white py-20 px-6 border-b-8 border-irokin-gold">
    <div class="container mx-auto">
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-4">Contact Us</h1>
      <p class="text-gray-300 text-xl max-w-3xl">Get a technical consultation for your building or electrical project.</p>
    </div>
  </section>

  <section class="py-24 px-6 bg-white">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Left Column: Contact Details & Map -->
        <div>
          <h2 class="text-3xl font-black text-irokin-blue uppercase tracking-tighter mb-8 border-l-8 border-irokin-gold pl-4">Office Location</h2>
          <div class="space-y-8 mb-12">
            <div>
              <h4 class="font-bold text-irokin-blue uppercase mb-2">Physical Address</h4>
              <p class="text-gray-700 font-body">No. 5 Amaokwe Item, Bende, Abia State, Nigeria</p>
            </div>
            <div>
              <h4 class="font-bold text-irokin-blue uppercase mb-2">Direct Contact</h4>
              <p class="text-gray-700 font-body">Mobile: <a href="tel:07038581945" class="hover:text-irokin-gold transition-colors">07038581945</a></p>
            </div>
            <div>
              <h4 class="font-bold text-irokin-blue uppercase mb-2">Business Hours</h4>
              <p class="text-gray-700 font-body">Monday — Saturday: 8:00 AM - 6:00 PM</p>
            </div>
          </div>

          <!-- Google Map Placeholder -->
          <div class="bg-slate-100 w-full h-80 border-4 border-irokin-blue flex items-center justify-center shadow-[12px_12px_0px_0px_rgba(10,25,47,0.2)]">
             <div class="text-center p-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-irokin-blue mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <p class="text-irokin-blue font-black uppercase tracking-widest text-sm">Abia State, Nigeria Map Placeholder</p>
             </div>
          </div>
        </div>

        <!-- Right Column: Contact Form -->
        <div class="bg-slate-50 p-8 md:p-12 border-2 border-irokin-blue shadow-[16px_16px_0px_0px_rgba(255,193,7,1)]">
          <h3 class="text-2xl font-black text-irokin-blue uppercase tracking-tighter mb-8">Send an Inquiry</h3>
          
          <form class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="full_name" class="block text-xs font-black uppercase text-irokin-blue mb-2">Full Name</label>
                <input type="text" id="full_name" name="full_name" required class="w-full bg-white border-2 border-irokin-blue p-3 focus:outline-none focus:ring-2 focus:ring-irokin-gold font-body" placeholder="John Doe">
              </div>
              <div>
                <label for="email" class="block text-xs font-black uppercase text-irokin-blue mb-2">Email Address</label>
                <input type="email" id="email" name="email" required class="w-full bg-white border-2 border-irokin-blue p-3 focus:outline-none focus:ring-2 focus:ring-irokin-gold font-body" placeholder="john@example.com">
              </div>
            </div>

            <div>
              <label for="phone" class="block text-xs font-black uppercase text-irokin-blue mb-2">Phone Number</label>
              <input type="tel" id="phone" name="phone" required class="w-full bg-white border-2 border-irokin-blue p-3 focus:outline-none focus:ring-2 focus:ring-irokin-gold font-body" placeholder="+234 ...">
            </div>

            <div>
              <label for="service" class="block text-xs font-black uppercase text-irokin-blue mb-2">Service Required</label>
              <select id="service" name="service" required class="w-full bg-white border-2 border-irokin-blue p-3 focus:outline-none focus:ring-2 focus:ring-irokin-gold font-body appearance-none">
                <option value="">Select a Service</option>
                <option value="building">Building Construction</option>
                <option value="electrical">Electrical & Smart Solar</option>
                <option value="repairs">Electronics Repairs</option>
                <option value="finishing">Interior Finishing</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <div>
              <label for="description" class="block text-xs font-black uppercase text-irokin-blue mb-2">Project Description</label>
              <textarea id="description" name="description" rows="4" required class="w-full bg-white border-2 border-irokin-blue p-3 focus:outline-none focus:ring-2 focus:ring-irokin-gold font-body" placeholder="Tell us about your project..."></textarea>
            </div>

            <button type="submit" class="w-full bg-irokin-gold text-irokin-blue font-black uppercase tracking-widest py-4 hover:bg-yellow-400 transition-all transform active:scale-95 shadow-lg">
              Send Inquiry
            </button>
          </form>
          
          <p class="text-xs text-gray-500 mt-6 font-body italic text-center">
            * We typically respond to technical inquiries within 24-48 hours.
          </p>
        </div>

      </div>
    </div>
  </section>
</Layout>
