---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Engineering Services">
  <!-- Page Header -->
  <section class="bg-irokin-blue text-white py-20 px-6 border-b-8 border-irokin-gold">
    <div class="container mx-auto">
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-4">Our Services</h1>
      <p class="text-gray-300 text-xl max-w-3xl">Precision engineering, industrial automation, and structural integrity for residential and commercial projects.</p>
    </div>
  </section>

  <!-- Technical Competencies Section -->
  <section class="py-20 px-6 bg-white">
    <div class="container mx-auto">
      <!-- Building Construction -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24 items-center">
        <div>
          <h2 class="text-3xl font-black text-irokin-blue uppercase tracking-tighter mb-6 border-l-8 border-irokin-gold pl-4">Building Construction</h2>
          <p class="text-gray-700 font-body mb-6 leading-relaxed">
            From foundation to finishing, we deliver structural excellence. Our building services are grounded in rigorous engineering standards and a commitment to durability. We specialize in integrated building solutions tailored to the unique landscape of Abia State.
          </p>
          <ul class="space-y-3 font-body text-sm font-bold text-irokin-blue">
            <li class="flex items-center gap-2"><span class="w-2 h-2 bg-irokin-gold"></span> Structural Engineering & Design</li>
            <li class="flex items-center gap-2"><span class="w-2 h-2 bg-irokin-gold"></span> Residential & Commercial Development</li>
            <li class="flex items-center gap-2"><span class="w-2 h-2 bg-irokin-gold"></span> Interior Finishing & Decoration</li>
            <li class="flex items-center gap-2"><span class="w-2 h-2 bg-irokin-gold"></span> Project Management & Supervision</li>
          </ul>
        </div>
        <div class="bg-slate-100 aspect-video flex items-center justify-center border-4 border-irokin-blue shadow-[16px_16px_0px_0px_rgba(255,193,7,1)]">
           <span class="text-irokin-blue font-black uppercase tracking-widest text-center px-4">Construction Placeholder</span>
        </div>
      </div>

      <!-- Electrical Work (High Technical Detail) -->
      <div class="bg-irokin-blue text-white p-12 md:p-20 border-r-8 border-irokin-gold mb-24">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter mb-8 text-irokin-gold">Electrical Engineering & Automation</h2>
          <p class="text-gray-300 font-body mb-12 text-lg">
            We don't just wire buildings; we engineer systems. Irokin specializes in high-reliability electrical infrastructure, from smart home integration to industrial-grade automation.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="border-t border-gray-700 pt-6">
              <h4 class="text-irokin-gold font-bold uppercase mb-4">Technical Competencies</h4>
              <ul class="space-y-4 font-body text-sm">
                <li><strong class="text-white">Residential & Industrial Wiring:</strong> Comprehensive circuit design, load balancing, and conduit installation.</li>
                <li><strong class="text-white">Low-Voltage Diagnostics:</strong> Precision troubleshooting of communication and control circuits.</li>
                <li><strong class="text-white">Industrial Panels:</strong> Design and assembly of distribution boards and control panels.</li>
              </ul>
            </div>
            <div class="border-t border-gray-700 pt-6">
              <h4 class="text-irokin-gold font-bold uppercase mb-4">Advanced Systems</h4>
              <ul class="space-y-4 font-body text-sm">
                <li><strong class="text-white">PLC Automation:</strong> Custom programming and installation of Programmable Logic Controllers for process automation.</li>
                <li><strong class="text-white">Smart Solar Solutions:</strong> Hybrid and off-grid solar installation with intelligent battery management systems.</li>
                <li><strong class="text-white">Troubleshooting:</strong> Advanced fault detection in complex electrical networks.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Electronics & Finishing -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1 bg-slate-100 aspect-video flex items-center justify-center border-4 border-irokin-blue shadow-[-16px_16px_0px_0px_rgba(255,193,7,1)]">
           <span class="text-irokin-blue font-black uppercase tracking-widest text-center px-4">Electronics Placeholder</span>
        </div>
        <div class="order-1 md:order-2">
          <h2 class="text-3xl font-black text-irokin-blue uppercase tracking-tighter mb-6 border-l-8 border-irokin-gold pl-4">Electronics & Finishing</h2>
          <p class="text-gray-700 font-body mb-6 leading-relaxed">
            Precision doesn't stop at the wires. Our electronics repair and interior finishing services ensure that your technology functions perfectly and your space looks impeccable.
          </p>
          <div class="space-y-6">
            <div class="p-6 bg-slate-50 border-2 border-irokin-blue">
               <h4 class="font-bold uppercase mb-2">Electronics Maintenance</h4>
               <p class="text-sm text-gray-600 font-body">Component-level repairs, device calibration, and preventive maintenance for consumer and industrial electronics.</p>
            </div>
            <div class="p-6 bg-slate-50 border-2 border-irokin-blue">
               <h4 class="font-bold uppercase mb-2">Interior Decoration</h4>
               <p class="text-sm text-gray-600 font-body">Master-class finishing, including painting, POP installation, and spatial planning for a modern industrial feel.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-irokin-blue py-20 px-6 text-center border-t-8 border-irokin-gold">
     <div class="container mx-auto">
        <h2 class="text-3xl font-black text-white mb-8 uppercase tracking-tighter">Need a Technical Consultation?</h2>
        <p class="text-gray-300 mb-10 max-w-xl mx-auto font-body">Contact us today to discuss your project requirements with our engineering team.</p>
        <a href="/contact" class="inline-block bg-irokin-gold text-irokin-blue px-12 py-4 font-black uppercase tracking-widest hover:bg-yellow-400 transition-colors">
           Get Started
        </a>
     </div>
  </section>
</Layout>
