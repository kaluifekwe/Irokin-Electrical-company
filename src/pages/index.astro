---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Solid, Safe, Right, Fine">
  <!-- Dynamic Hero Section -->
  <section class="relative bg-irokin-blue text-white overflow-hidden min-h-[70vh] flex items-center border-b-8 border-irokin-gold">
    <!-- Background Carousel Images -->
    <div id="hero-carousel" class="absolute inset-0 z-0">
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1555664424-778a1e5e1b48?auto=format&fit=crop&q=80');"></div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1503387762-592dea58ef21?auto=format&fit=crop&q=80');"></div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1509391366360-fe585c9233a5?auto=format&fit=crop&q=80');"></div>
      <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80');"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-12 drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
          <span id="flipping-text" class="text-irokin-gold block transition-all duration-500 transform translate-y-0 opacity-100 italic">WE BUILD IT SOLID</span>
        </h1>
        <div class="flex flex-wrap gap-6">
          <a href="/contact" class="bg-irokin-gold text-irokin-blue px-10 py-4 font-black uppercase tracking-widest hover:bg-yellow-400 transition-all transform hover:-translate-y-1 shadow-[0_10px_20px_rgba(0,0,0,0.4)] text-sm">
            Request a Consultation
          </a>
          <a href="/services" class="border-2 border-white text-white px-10 py-4 font-black uppercase tracking-widest hover:bg-white hover:text-irokin-blue transition-all text-sm drop-shadow-lg shadow-[0_10px_20px_rgba(0,0,0,0.4)]">
            Our Services
          </a>
        </div>
      </div>
    </div>

    <!-- Progress Dots -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-3">
      <div class="progress-dot w-3 h-3 bg-irokin-gold rounded-full transition-all duration-300"></div>
      <div class="progress-dot w-3 h-3 bg-white/30 rounded-full transition-all duration-300"></div>
      <div class="progress-dot w-3 h-3 bg-white/30 rounded-full transition-all duration-300"></div>
      <div class="progress-dot w-3 h-3 bg-white/30 rounded-full transition-all duration-300"></div>
    </div>
  </section>

  <script>
    const phrases = [
      "WE BUILD IT SOLID",
      "WE WIRE IT SAFE",
      "WE REPAIR IT RIGHT",
      "WE FINISH IT FINE"
    ];
    
    let currentIndex = 0;
    const textElement = document.getElementById('flipping-text');
    const carouselItems = document.querySelectorAll('.carousel-item');
    const dots = document.querySelectorAll('.progress-dot');

    function updateHero() {
      // Update Text with animation
      if (textElement) {
        textElement.style.opacity = '0';
        textElement.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
          textElement.textContent = phrases[currentIndex];
          textElement.style.opacity = '1';
          textElement.style.transform = 'translateY(0)';
        }, 500);
      }

      // Update Background
      carouselItems.forEach((item, index) => {
        if (index === currentIndex) {
          (item as HTMLElement).style.opacity = '1';
        } else {
          (item as HTMLElement).style.opacity = '0';
        }
      });

      // Update Dots
      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          (dot as HTMLElement).style.backgroundColor = '#FFC107';
          (dot as HTMLElement).style.transform = 'scale(1.2)';
        } else {
          (dot as HTMLElement).style.backgroundColor = 'rgba(255, 255, 255, 0.3)';
          (dot as HTMLElement).style.transform = 'scale(1)';
        }
      });

      currentIndex = (currentIndex + 1) % phrases.length;
    }

    // Initial call
    updateHero();
    // Set interval (every 4 seconds for better readability)
    setInterval(updateHero, 4000);
  </script>

  <!-- Services Grid -->
  <section class="py-24 px-6 bg-slate-50">
    <div class="container mx-auto">
      <h2 class="text-3xl font-black mb-16 text-irokin-blue border-l-8 border-irokin-gold pl-4 uppercase tracking-tighter">
        Core Competencies
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Construction -->
        <div class="bg-white border-2 border-irokin-blue p-8 shadow-[8px_8px_0px_0px_rgba(10,25,47,1)] hover:shadow-none transition-all">
          <div class="text-irokin-gold mb-4">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
             </svg>
          </div>
          <h3 class="text-xl font-bold mb-3 uppercase">Building Construction</h3>
          <p class="text-gray-600 text-sm font-body">Structural engineering and integrated building services delivered with uncompromising integrity.</p>
        </div>

        <!-- Electrical -->
        <div class="bg-white border-2 border-irokin-blue p-8 shadow-[8px_8px_0px_0px_rgba(10,25,47,1)] hover:shadow-none transition-all">
          <div class="text-irokin-gold mb-4">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
             </svg>
          </div>
          <h3 class="text-xl font-bold mb-3 uppercase">General Electrical & Solar</h3>
          <p class="text-gray-600 text-sm font-body">Smart home wiring, solar systems, and industrial automation (PLC) solutions.</p>
        </div>

        <!-- Repairs -->
        <div class="bg-white border-2 border-irokin-blue p-8 shadow-[8px_8px_0px_0px_rgba(10,25,47,1)] hover:shadow-none transition-all">
          <div class="text-irokin-gold mb-4">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 011-1h1a2 2 0 100-4H7a1 1 0 01-1-1V7a1 1 0 011-1h3a1 1 0 011 1V4z" />
             </svg>
          </div>
          <h3 class="text-xl font-bold mb-3 uppercase">Electronics Repairs</h3>
          <p class="text-gray-600 text-sm font-body">Low-voltage troubleshooting and precision electronics maintenance for home and industry.</p>
        </div>

        <!-- Interior -->
        <div class="bg-white border-2 border-irokin-blue p-8 shadow-[8px_8px_0px_0px_rgba(10,25,47,1)] hover:shadow-none transition-all">
          <div class="text-irokin-gold mb-4">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
             </svg>
          </div>
          <h3 class="text-xl font-bold mb-3 uppercase">Interior & Finishing</h3>
          <p class="text-gray-600 text-sm font-body">Premium interior decoration and finishing services to give your space a master touch.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 px-6 bg-white">
    <div class="container mx-auto">
       <div class="flex flex-col md:flex-row items-center gap-16">
          <div class="md:w-1/2">
             <h2 class="text-3xl font-black mb-8 text-irokin-blue uppercase tracking-tighter">Our Core Foundations</h2>
             <div class="space-y-6">
                <div class="flex items-start gap-4">
                   <span class="bg-irokin-gold text-irokin-blue font-bold px-3 py-1">01</span>
                   <div>
                      <h4 class="font-bold uppercase">Safety</h4>
                      <p class="text-gray-600 text-sm font-body">Zero-compromise electrical safety and structural integrity.</p>
                   </div>
                </div>
                <div class="flex items-start gap-4">
                   <span class="bg-irokin-gold text-irokin-blue font-bold px-3 py-1">02</span>
                   <div>
                      <h4 class="font-bold uppercase">Quality</h4>
                      <p class="text-gray-600 text-sm font-body">Industrial-grade materials and master-level craftsmanship.</p>
                   </div>
                </div>
                <div class="flex items-start gap-4">
                   <span class="bg-irokin-gold text-irokin-blue font-bold px-3 py-1">03</span>
                   <div>
                      <h4 class="font-bold uppercase">Innovation</h4>
                      <p class="text-gray-600 text-sm font-body">Smart solar and PLC-based automation for modern living.</p>
                   </div>
                </div>
             </div>
          </div>
          <div class="md:w-1/2 bg-irokin-blue p-12 text-white border-r-8 border-irokin-gold">
             <p class="text-2xl font-bold italic mb-6">"Establishing deep technical authority through integrated engineering excellence."</p>
             <p class="text-irokin-gold font-bold">— Engr. Okoji Joseph Okezie, CEO</p>
          </div>
       </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-irokin-gold py-16 px-6 text-center">
     <div class="container mx-auto">
        <h2 class="text-3xl md:text-4xl font-black text-irokin-blue mb-8 uppercase tracking-tighter">Ready to start your project?</h2>
        <a href="/contact" class="inline-block bg-irokin-blue text-white px-12 py-4 font-black uppercase tracking-widest hover:bg-slate-800 transition-colors">
           Contact Us Now
        </a>
     </div>
  </section>
</Layout>
