---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Irokin">
  <!-- Page Header -->
  <section class="bg-irokin-blue text-white py-20 px-6 border-b-2 border-irokin-gold">
    <div class="container mx-auto">
      <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tighter mb-4">Our Story</h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl">Turning building concepts into safe, functional, and beautiful spaces.</p>
    </div>
  </section>

  <!-- Corporate Narrative Section -->
  <section class="py-20 px-6 bg-white">
    <div class="container mx-auto">
      <div class="max-w-4xl mx-auto space-y-16">
        
        <!-- Integrated Expertise -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl font-black text-irokin-blue uppercase tracking-tight mb-6 border-l-4 border-irokin-gold pl-4">Integrated Engineering</h2>
            <p class="text-gray-700 font-body leading-relaxed mb-6">
              Irokin Electrical and Building Construction is an integrated building and services company based in Abia State, Nigeria. We specialize in turning building concepts into safe, functional, and beautiful spaces — from start to finish.
            </p>
            <p class="text-gray-700 font-body leading-relaxed">
              With years of hands-on experience, Irokin handles the full project cycle under one roof. This integrated approach saves our clients time and money while removing the stress of managing multiple contractors.
            </p>
          </div>
          <div class="bg-slate-50 p-8 border border-gray-200 shadow-sm">
            <h3 class="text-irokin-blue font-bold uppercase text-sm mb-4 tracking-widest italic">The Irokin Advantage</h3>
            <ul class="space-y-3 font-body text-xs font-bold text-gray-600">
              <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-irokin-gold"></span> Solid Building Construction</li>
              <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-irokin-gold"></span> Professional Electrical Installations</li>
              <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-irokin-gold"></span> Skilled Electronics Repairs</li>
              <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-irokin-gold"></span> Modern Interior Finishing</li>
            </ul>
          </div>
        </div>

        <!-- Team & Standards -->
        <div class="border-t border-gray-100 pt-16">
          <h2 class="text-2xl font-black text-irokin-blue uppercase tracking-tight mb-8 text-center">Professional Standards</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div class="p-6 bg-slate-50 border border-gray-200 shadow-sm">
              <h4 class="font-black uppercase text-irokin-blue mb-2 text-sm italic">Our Team</h4>
              <p class="text-xs text-gray-600 font-body leading-relaxed">Qualified builders, certified electricians, and electronics technicians committed to honest service.</p>
            </div>
            <div class="p-6 bg-slate-50 border border-gray-200 shadow-sm">
              <h4 class="font-black uppercase text-irokin-blue mb-2 text-sm italic">Excellence</h4>
              <p class="text-xs text-gray-600 font-body leading-relaxed">We deliver projects that meet Nigerian building standards and exceed client expectations.</p>
            </div>
            <div class="p-6 bg-slate-50 border border-gray-200 shadow-sm">
              <h4 class="font-black uppercase text-irokin-blue mb-2 text-sm italic">Versatility</h4>
              <p class="text-xs text-gray-600 font-body leading-relaxed">Handling residential homes, office complexes, shops, or industrial facilities with ease.</p>
            </div>
          </div>
        </div>

        <!-- The Promise -->
        <div class="bg-irokin-blue text-white p-10 md:p-16 border-l-4 border-irokin-gold shadow-lg">
          <p class="text-lg md:text-2xl font-bold italic mb-8 leading-relaxed">
            "At Irokin, we believe a strong building needs safe wiring, reliable systems, and a finish that reflects your style."
          </p>
          <div class="flex flex-wrap gap-4 items-center">
             <span class="text-irokin-gold font-black uppercase tracking-widest text-sm">Our Simple Promise:</span>
             <span class="text-xs font-bold uppercase tracking-tighter border-b border-irokin-gold pb-1">Build Solid</span>
             <span class="text-xs font-bold uppercase tracking-tighter border-b border-irokin-gold pb-1">Wire Safe</span>
             <span class="text-xs font-bold uppercase tracking-tighter border-b border-irokin-gold pb-1">Repair Right</span>
             <span class="text-xs font-bold uppercase tracking-tighter border-b border-irokin-gold pb-1">Finish Fine</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 px-6 bg-slate-50 text-center border-t border-gray-100">
    <div class="container mx-auto">
      <h2 class="text-2xl font-black text-irokin-blue uppercase tracking-tight mb-8">Work With an Integrated Engineering Team</h2>
      <a href="/contact" class="inline-block bg-irokin-gold text-irokin-blue px-10 py-3 font-black uppercase tracking-wider hover:bg-yellow-400 transition-all text-xs shadow-md">
        Request a Consultation
      </a>
    </div>
  </section>
</Layout>
