---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Irokin Electrical & Building Construction</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="sticky top-0 z-50 bg-irokin-blue text-white py-4 px-6 shadow-lg border-b border-irokin-gold/20">
      <nav class="container mx-auto flex justify-between items-center">
        <a href="/" class="flex items-center space-x-3 group">
          <img src="/images/logo.png" alt="Irokin Logo" class="h-10 w-auto p-1 bg-white border border-irokin-gold/30 shadow-sm" />
          <div class="flex flex-col">
            <span class="text-lg font-black leading-none tracking-tighter uppercase text-irokin-gold">IROKIN</span>
            <span class="text-[9px] text-gray-300 font-bold uppercase tracking-[0.2em] leading-none mt-1">ELECTRICAL & BUILDING</span>
          </div>
        </a>
        
        <!-- Desktop Navigation -->
        <div class="hidden md:flex space-x-8 items-center font-bold text-xs uppercase tracking-widest text-white">
          <a href="/" class="hover:text-irokin-gold transition-colors active:text-irokin-gold">Home</a>
          <a href="/about" class="hover:text-irokin-gold transition-colors active:text-irokin-gold">About</a>
          <a href="/services" class="hover:text-irokin-gold transition-colors active:text-irokin-gold">Services</a>
          <a href="/projects" class="hover:text-irokin-gold transition-colors active:text-irokin-gold">Projects</a>
          <a href="/contact" class="hover:text-irokin-gold transition-colors active:text-irokin-gold">Contact</a>
          <a href="/contact" class="bg-irokin-gold text-irokin-blue px-6 py-2 font-black hover:bg-yellow-400 transition-all transform active:scale-95 shadow-sm">
            Get a Quote
          </a>
        </div>

        <!-- Mobile Toggle Button -->
        <button id="mobile-menu-toggle" class="md:hidden text-irokin-gold focus:outline-none" aria-label="Toggle Menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </nav>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-irokin-blue border-b border-irokin-gold/20 shadow-2xl md:hidden transition-all duration-300 ease-in-out">
        <div class="flex flex-col p-8 space-y-6 text-center font-bold text-sm uppercase tracking-[0.2em]">
          <a href="/" class="text-white hover:text-irokin-gold py-2 transition-colors border-b border-white/5">Home</a>
          <a href="/about" class="text-white hover:text-irokin-gold py-2 transition-colors border-b border-white/5">About</a>
          <a href="/services" class="text-white hover:text-irokin-gold py-2 transition-colors border-b border-white/5">Services</a>
          <a href="/projects" class="text-white hover:text-irokin-gold py-2 transition-colors border-b border-white/5">Projects</a>
          <a href="/contact" class="text-white hover:text-irokin-gold py-2 transition-colors border-b border-white/5">Contact</a>
          <a href="/contact" class="bg-irokin-gold text-irokin-blue px-6 py-4 font-black mt-4 shadow-lg active:scale-95 transition-transform">
            Get a Quote
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Floating WhatsApp Button -->
    <a 
      href="https://wa.me/2347038581945?text=Hello%20Irokin%20Electricals,%20I%20would%20like%20to%20inquire%20about%20your%20services." 
      target="_blank" 
      rel="noopener noreferrer"
      class="fixed bottom-8 right-8 z-[60] bg-[#25D366] text-white p-3 rounded-full shadow-lg hover:scale-110 active:scale-95 transition-all group border-2 border-white"
      aria-label="Contact on WhatsApp"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span class="absolute right-full mr-3 bg-irokin-blue text-white text-[9px] font-bold py-1.5 px-3 rounded shadow-md whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none uppercase tracking-widest border border-irokin-gold/20">
        WhatsApp
      </span>
    </a>

    <footer class="bg-irokin-blue text-white py-12 px-6 border-t border-irokin-gold/20">
      <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <h3 class="text-sm font-black uppercase mb-4 tracking-wider text-irokin-gold">Irokin Engineering</h3>
          <p class="text-gray-300 text-[10px] mb-2 font-bold tracking-widest">RC: 9500063</p>
          <p class="text-[11px] text-gray-300 font-medium">CEO: Engr. Okoji Joseph Okezie</p>
        </div>
        <div>
          <h4 class="text-xs font-bold uppercase mb-4 tracking-widest text-white">Contact</h4>
          <p class="text-[11px] text-gray-300 mb-2 font-medium leading-relaxed">
            <a 
              href="https://www.google.com/maps/search/?api=1&query=No.+5+Amaokwe+Item,+Bende,+Abia+State,+Nigeria" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-irokin-gold transition-colors"
            >
              No. 5 Amaokwe Item, Bende, Abia State, Nigeria
            </a>
          </p>
          <p class="text-[11px] text-irokin-gold font-bold">07038581945</p>
        </div>
        <div>
          <h4 class="text-xs font-bold uppercase mb-4 tracking-widest text-white">Navigation</h4>
          <ul class="text-[11px] space-y-2 text-gray-300 font-medium">
            <li><a href="/services" class="hover:text-irokin-gold transition-colors">Our Services</a></li>
            <li><a href="/projects" class="hover:text-irokin-gold transition-colors">Recent Projects</a></li>
            <li><a href="/about" class="hover:text-irokin-gold transition-colors">Our Story</a></li>
          </ul>
        </div>
      </div>
      <div class="container mx-auto mt-10 pt-6 border-t border-white/10 text-center text-[9px] text-gray-400 uppercase tracking-[0.2em] font-bold">
        <p>&copy; {currentYear} Irokin Electricals. All rights reserved.</p>
      </div>
    </footer>

    <!-- Mobile Menu Logic -->
    <script>
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');

      if (toggleBtn && mobileMenu && menuIcon) {
        toggleBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            // Change to close icon
            menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
          } else {
            mobileMenu.classList.add('hidden');
            // Change back to hamburger icon
            menuIcon.setAttribute('d', 'M4 6h16M4 12h16m-7 6h7');
          }
        });

        // Close menu when clicking a link
        const navLinks = mobileMenu.querySelectorAll('a');
        navLinks.forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            menuIcon.setAttribute('d', 'M4 6h16M4 12h16m-7 6h7');
          });
        });
      }
    </script>
  </body>
</html>
